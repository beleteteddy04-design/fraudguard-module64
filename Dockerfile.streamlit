FROM python:3.12-slim-bookworm

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/home/fraudguard

COPY requirements-ui.txt .
RUN python -m pip install --no-cache-dir -r requirements-ui.txt \
    && useradd --uid 10001 --create-home fraudguard

COPY app.py ./
COPY models/fraudguard_meta.json ./models/
COPY examples/demo_transactions.csv ./examples/

USER fraudguard
EXPOSE 8501
CMD ["sh", "-c", "exec python -m streamlit run app.py --server.address=0.0.0.0 --server.port=${PORT:-8501} --server.headless=true --browser.gatherUsageStats=false"]
